{
    "headers": [
        {
            "source": "/downloads/(.*).apk",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/vnd.android.package-archive"
                },
                {
                    "key": "Content-Disposition",
                    "value": "attachment; filename=Twingle.apk"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(favicon.ico|favicon.svg|twingle-logo.png|manifest.json|robots.txt|sitemap.xml|downloads/.*)",
            "destination": "/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}